{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Reclaim",
  "version": "0.1.4",
  "identifier": "com.reclaim.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Reclaim",
        "width": 1000,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyRDZBQzAwQzJDMkU5QjMKUldTejZjTENBS3pXOHVGWklsWDg2TGloZmkvbnRaN0U1a1VJSFV6RXFodnBmNjdxUlpvSWZTa0MK",
      "endpoints": [
        "https://github.com/harshwardhan847/reclaim/releases/latest/download/latest.json"
      ]
    }
  }
}
