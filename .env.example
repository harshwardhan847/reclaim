# Dodo Payments checkout URL used for "Get Pro License" / "Buy a license" CTAs.
VITE_DODO_CHECKOUT_URL=

# PostHog analytics (client-side, see src/lib/analytics.ts).
# Leave VITE_POSTHOG_KEY empty to disable analytics — it fails gracefully.
VITE_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com in code if unset.
VITE_POSTHOG_HOST=
